<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Tropico.Desktop.ViewModels"
        xmlns:services="using:Tropico.Desktop.Services"
        xmlns:c="using:Tropico.Desktop.Controls"
        xmlns:loc="using:Tropico.Desktop.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="720"
        x:Class="Tropico.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Width="1120" Height="780" MinWidth="960"
        Title="Tropico Advisor"
        FlowDirection="{Binding LayoutDirection}">

    <Design.DataContext>
        <!-- Design-time only: the runtime DataContext is set in App.axaml.cs -->
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.DataTemplates>

        <DataTemplate DataType="vm:FindingViewModel">
            <Border Classes="card finding" Margin="0,0,0,8"
                    Classes.warning="{Binding IsWarning}"
                    Classes.critical="{Binding IsCritical}"
                    Classes.uncertain="{Binding IsUncertain}">
                <StackPanel Spacing="4">
                    <TextBlock Classes="message" Text="{Binding Message}" TextWrapping="Wrap" FontWeight="SemiBold" />
                    <ItemsControl ItemsSource="{Binding Evidence}" IsVisible="{Binding HasEvidence}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Classes="caption" Text="{Binding StringFormat='• {0}'}" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding Suggestion, StringFormat='→ {0}'}" IsVisible="{Binding HasSuggestion}" TextWrapping="Wrap" />
                    <TextBlock Classes="caption" Text="{Binding Label}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="vm:BarRow">
            <Grid ColumnDefinitions="220,*,120" Margin="0,2">
                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                <ProgressBar Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding Fraction}" Height="10" Margin="8,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Classes="num" Text="{Binding Value}" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="vm:BuildingClassRow">
            <Grid ColumnDefinitions="*,60,110,170,90,140,60" Margin="0,2">
                <TextBlock Text="{Binding Name}" />
                <TextBlock Grid.Column="1" Classes="num" Text="{Binding Count}" />
                <TextBlock Grid.Column="2" Classes="num" Text="{Binding Condition}" />
                <TextBlock Grid.Column="3" Margin="12,0,0,0" Text="{Binding Workmode}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="4" Classes="num" Text="{Binding Budget}" />
                <TextBlock Grid.Column="5" Margin="12,0,0,0" Text="{Binding Outputs}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="6" Classes="num" Text="{Binding Fill}" />
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="vm:ProductionRow">
            <Grid ColumnDefinitions="*,80,90,90,60,60,90,90" Margin="0,2">
                <TextBlock Text="{Binding Resource}" />
                <TextBlock Grid.Column="1" Classes="num" Text="{Binding Producers}" />
                <TextBlock Grid.Column="2" Classes="num" Text="{Binding Output}" />
                <TextBlock Grid.Column="3" Classes="num" Text="{Binding Capacity}" />
                <TextBlock Grid.Column="4" Classes="num" Text="{Binding Fill}" />
                <TextBlock Grid.Column="5" Classes="num" Text="{Binding Full}" />
                <TextBlock Grid.Column="6" Classes="num" Text="{Binding IslandStock}" />
                <TextBlock Grid.Column="7" Classes="num" Text="{Binding Exported}" />
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="vm:DepositRow">
            <Grid ColumnDefinitions="*,80,100,90,110" Margin="0,2">
                <TextBlock Text="{Binding Resource}" />
                <TextBlock Grid.Column="1" Classes="num" Text="{Binding Deposits}" />
                <TextBlock Grid.Column="2" Classes="num" Text="{Binding InUse}" />
                <TextBlock Grid.Column="3" Classes="num" Text="{Binding Producers}" />
                <TextBlock Grid.Column="4" Classes="num" Text="{Binding Amount}" />
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="vm:FactionRow">
            <Grid ColumnDefinitions="150,80,150,*" Margin="0,2">
                <TextBlock Text="{Binding Name}" />
                <TextBlock Grid.Column="1" Classes="num" Classes.negative="{Binding IsNegative}" Text="{Binding Standing}" />
                <TextBlock Grid.Column="2" Classes="num" Text="{Binding History}" />
                <TextBlock Grid.Column="3" Margin="16,0,0,0" Text="{Binding Causes}" TextWrapping="Wrap" />
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="vm:EdictRow">
            <Grid ColumnDefinitions="*,120" Margin="0,2">
                <TextBlock Text="{Binding Name}" />
                <TextBlock Grid.Column="1" Classes="num" Text="{Binding Active}" />
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="vm:ConstitutionRow">
            <Grid ColumnDefinitions="*,*" Margin="0,2">
                <TextBlock Text="{Binding Topic}" />
                <TextBlock Grid.Column="1" Text="{Binding Option}" />
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="vm:DemandRow">
            <Grid ColumnDefinitions="*,120" Margin="0,2">
                <TextBlock Text="{Binding Name}" />
                <TextBlock Grid.Column="1" Classes="num" Text="{Binding Status}" />
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="vm:ChangeRow">
            <Grid ColumnDefinitions="*,110,110,110" Margin="0,2">
                <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                <TextBlock Grid.Column="1" Classes="num" Text="{Binding Before}" />
                <TextBlock Grid.Column="2" Classes="num" Text="{Binding Now}" />
                <TextBlock Grid.Column="3" Classes="num" FontWeight="SemiBold"
                           Classes.good="{Binding IsGood}" Classes.bad="{Binding IsBad}" Text="{Binding Change}" />
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="vm:SnapshotRow">
            <Grid ColumnDefinitions="*,120,120" Margin="0,2">
                <TextBlock Text="{Binding Save}" TextWrapping="Wrap" />
                <TextBlock Grid.Column="1" Classes="num" Text="{Binding GameDate}" />
                <TextBlock Grid.Column="2" Classes="num" Text="{Binding AnalysedOn}" />
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="vm:BreakdownRow">
            <Grid ColumnDefinitions="*,110,60" Margin="0,2">
                <TextBlock Text="{Binding Name}" />
                <TextBlock Grid.Column="1" Classes="num" Text="{Binding Amount}" />
                <TextBlock Grid.Column="2" Classes="num caption" Text="{Binding Share}" />
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="vm:CostCenterRow">
            <Grid ColumnDefinitions="*,70,90,90,90,100" Margin="0,2">
                <TextBlock Text="{Binding Name}" />
                <TextBlock Grid.Column="1" Classes="num" Text="{Binding Buildings}" />
                <TextBlock Grid.Column="2" Classes="num" Text="{Binding Wages}" />
                <TextBlock Grid.Column="3" Classes="num" Text="{Binding Upkeep}" />
                <TextBlock Grid.Column="4" Classes="num" Text="{Binding Income}" />
                <TextBlock Grid.Column="5" Classes="num" Text="{Binding PerBuilding}" />
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="vm:GoodRow">
            <Grid ColumnDefinitions="*,70,70,90,90,80,80,70" Margin="0,2">
                <TextBlock Text="{Binding Resource}" />
                <TextBlock Grid.Column="1" Classes="num" Text="{Binding Price}" />
                <TextBlock Grid.Column="2" Classes="num" Text="{Binding PriceChange}" />
                <TextBlock Grid.Column="3" Classes="num" Text="{Binding Stock}" />
                <TextBlock Grid.Column="4" Classes="num" Text="{Binding StockValue}" />
                <TextBlock Grid.Column="5" Classes="num" Text="{Binding Exported}" />
                <TextBlock Grid.Column="6" Classes="num" Text="{Binding Imported}" />
                <TextBlock Grid.Column="7" Classes="num" Text="{Binding Routes}" />
            </Grid>
        </DataTemplate>

    </Window.DataTemplates>

    <DockPanel Margin="16">

        <!-- ============ Header ============ -->
        <Border DockPanel.Dock="Top" Background="{StaticResource TropicoHeaderBrush}" CornerRadius="12" Padding="18,14"
                BorderBrush="{StaticResource TropicoCardBorderBrush}" BorderThickness="1"
                BoxShadow="0 8 22 0 #66000000">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto">
                <Border Width="46" Height="46" CornerRadius="23" Margin="0,0,16,0"
                        Background="{StaticResource TropicoSunBrush}" BoxShadow="0 0 24 4 #88F2B84B" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Classes="brand" Text="TROPICO ADVISOR" />
                    <TextBlock Classes="caption" Text="{loc:T ui.theAlmanacAndTheAdvisorOf}" />
                </StackPanel>
                <ComboBox Grid.Column="2" Width="130" Margin="0,0,10,0" VerticalAlignment="Center"
                          ItemsSource="{Binding AvailableLanguages}"
                          SelectedItem="{Binding SelectedLanguage}" />
                <ComboBox Grid.Column="3" Width="300" Margin="0,0,10,0" VerticalAlignment="Center"
                          ItemsSource="{Binding Saves}"
                          SelectedItem="{Binding SelectedSave}"
                          PlaceholderText="{loc:T ui.selectATropico6Save}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="services:SaveFileItem">
                            <TextBlock Text="{Binding DisplayName}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Grid.Column="4" Content="{loc:T ui.refresh}" VerticalAlignment="Center"
                        Command="{Binding RefreshCommand}" />
                <Button Grid.Column="5" Content="{loc:T ui.exportReport}" VerticalAlignment="Center" Margin="10,0,0,0"
                        Click="OnExportClick" />
            </Grid>
        </Border>
        <Border DockPanel.Dock="Top" Height="4" CornerRadius="2" Margin="0,10,0,12"
                Background="{StaticResource TropicoStripeBrush}" />

        <TextBlock DockPanel.Dock="Top" Text="{loc:T ui.analysingSave}" IsVisible="{Binding IsBusy}" Margin="0,0,0,8" />
        <TextBlock DockPanel.Dock="Top" Text="{Binding ErrorMessage}" Foreground="{StaticResource TropicoNegativeBrush}"
                   IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   TextWrapping="Wrap" Margin="0,0,0,8" />
        <TextBlock DockPanel.Dock="Top" Text="{Binding StatusMessage}"
                   IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   Margin="0,0,0,8" />

        <ContentControl Content="{Binding Report}"
                        IsVisible="{Binding Report, Converter={x:Static ObjectConverters.IsNotNull}}">
            <ContentControl.ContentTemplate>
                <DataTemplate x:DataType="vm:IslandReportViewModel">
                    <TabControl>

                        <!-- ============ Overview ============ -->
                        <TabItem Header="{loc:T ui.overview}">
                            <ScrollViewer>
                                <StackPanel Spacing="12" Margin="0,8,12,8">
                                    <StackPanel>
                                        <TextBlock Classes="title" Text="{Binding Title}" />
                                        <TextBlock Classes="caption" Text="{Binding GameBuild}" />
                                    </StackPanel>

                                    <UniformGrid Columns="3">
                                        <Border Classes="card" Margin="0,0,8,0">
                                            <StackPanel>
                                                <TextBlock Classes="caption" Text="{loc:T ui.buildings}" />
                                                <TextBlock Classes="value" Text="{Binding Buildings}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Classes="card" Margin="4,0">
                                            <StackPanel>
                                                <TextBlock Classes="caption" Text="{loc:T ui.citizens}" />
                                                <TextBlock Classes="value" Text="{Binding Citizens}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Classes="card" Margin="8,0,0,0">
                                            <StackPanel>
                                                <TextBlock Classes="caption" Text="{loc:T ui.treasury}" />
                                                <TextBlock Classes="value" Text="{Binding Treasury}" />
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>

                                    <TextBlock Classes="section" Text="{loc:T ui.suggestions}" />
                                    <StackPanel Orientation="Horizontal" Spacing="12" IsVisible="{Binding HasAnyFindings}">
                                        <ComboBox Width="260" ItemsSource="{Binding FilterOptions}" SelectedIndex="{Binding SelectedFilter}" />
                                        <CheckBox Content="{loc:T ui.hideUncertain}" IsChecked="{Binding HideUncertain}" VerticalAlignment="Center" />
                                        <TextBlock Classes="caption" Text="{Binding FilterSummary}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Classes="caption" Text="{loc:T ui.noFindings}" IsVisible="{Binding !HasFindings}" />
                                    <ItemsControl ItemsSource="{Binding Findings}" />

                                    <TextBlock Classes="section" Text="{loc:T ui.mostCommonBuildings}" />
                                    <ItemsControl ItemsSource="{Binding TopBuildings}" />
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- ============ Buildings ============ -->
                        <TabItem Header="{loc:T ui.buildings}">
                            <ScrollViewer>
                                <StackPanel Spacing="12" Margin="0,8,12,8" DataContext="{Binding BuildingsTab}" x:DataType="vm:BuildingsViewModel">

                                    <UniformGrid Columns="4">
                                        <Border Classes="card" Margin="0,0,6,0">
                                            <StackPanel>
                                                <TextBlock Classes="caption" Text="{loc:T ui.buildings}" />
                                                <TextBlock Classes="value" Text="{Binding Total}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Classes="card" Margin="3,0">
                                            <StackPanel>
                                                <TextBlock Classes="caption" Text="{loc:T ui.producers}" />
                                                <TextBlock Classes="value" Text="{Binding Producers}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Classes="card" Margin="3,0">
                                            <StackPanel>
                                                <TextBlock Classes="caption" Text="{loc:T ui.fullOutputStorage}" />
                                                <TextBlock Classes="value" Text="{Binding FullOutputs}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Classes="card" Margin="6,0,0,0">
                                            <StackPanel>
                                                <TextBlock Classes="caption" Text="{loc:T ui.notInGoodCondition}" />
                                                <TextBlock Classes="value" Text="{Binding NotBuilt}" />
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>

                                    <TextBlock Classes="section" Text="{loc:T ui.suggestions}" IsVisible="{Binding HasFindings}" />
                                    <ItemsControl ItemsSource="{Binding Findings}" />

                                    <TextBlock Classes="section" Text="{loc:T ui.productionByResource}" />
                                    <TextBlock Classes="caption" TextWrapping="Wrap"
                                               Text="{loc:T ui.outputStorageOfTheProducersA}" />
                                    <Grid ColumnDefinitions="*,80,90,90,60,60,90,90">
                                        <TextBlock Classes="head" Text="{loc:T ui.resource}" />
                                        <TextBlock Grid.Column="1" Classes="head num" Text="{loc:T ui.producers}" />
                                        <TextBlock Grid.Column="2" Classes="head num" Text="{loc:T ui.output}" />
                                        <TextBlock Grid.Column="3" Classes="head num" Text="{loc:T ui.capacity}" />
                                        <TextBlock Grid.Column="4" Classes="head num" Text="{loc:T ui.fill}" />
                                        <TextBlock Grid.Column="5" Classes="head num" Text="{loc:T ui.full}" />
                                        <TextBlock Grid.Column="6" Classes="head num" Text="{loc:T ui.islandStock}" />
                                        <TextBlock Grid.Column="7" Classes="head num" Text="{loc:T ui.exported}" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding Resources}" />

                                    <TextBlock Classes="section" Text="{loc:T ui.buildingsByClass}" />
                                    <TextBlock Classes="caption" TextWrapping="Wrap"
                                               Text="{loc:T ui.workmodeAndBudgetLevelAreThe}" />
                                    <Grid ColumnDefinitions="*,60,110,170,90,140,60">
                                        <TextBlock Classes="head" Text="{loc:T ui.class}" />
                                        <TextBlock Grid.Column="1" Classes="head num" Text="{loc:T ui.count}" />
                                        <TextBlock Grid.Column="2" Classes="head num" Text="{loc:T ui.condition}" />
                                        <TextBlock Grid.Column="3" Classes="head" Margin="12,0,0,0" Text="{loc:T ui.workmode}" />
                                        <TextBlock Grid.Column="4" Classes="head num" Text="{loc:T ui.budget}" />
                                        <TextBlock Grid.Column="5" Classes="head" Margin="12,0,0,0" Text="{loc:T ui.produces}" />
                                        <TextBlock Grid.Column="6" Classes="head num" Text="{loc:T ui.fill}" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding Classes}" />

                                    <TextBlock Classes="section" Text="{loc:T ui.resourceDeposits}" />
                                    <TextBlock Classes="caption" TextWrapping="Wrap"
                                               Text="{loc:T ui.depositsInUseAreEstimatedEach}" />
                                    <Grid ColumnDefinitions="*,80,100,90,110">
                                        <TextBlock Classes="head" Text="{loc:T ui.resource}" />
                                        <TextBlock Grid.Column="1" Classes="head num" Text="{loc:T ui.deposits}" />
                                        <TextBlock Grid.Column="2" Classes="head num" Text="{loc:T ui.inUseEst}" />
                                        <TextBlock Grid.Column="3" Classes="head num" Text="{loc:T ui.producers}" />
                                        <TextBlock Grid.Column="4" Classes="head num" Text="{loc:T ui.amountEach}" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding Deposits}" />
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- ============ Population ============ -->
                        <TabItem Header="{loc:T ui.population}">
                            <ScrollViewer>
                                <StackPanel Spacing="12" Margin="0,8,12,8" DataContext="{Binding Population}" x:DataType="vm:PopulationViewModel">

                                    <UniformGrid Columns="4">
                                        <Border Classes="card" Margin="0,0,6,0">
                                            <StackPanel>
                                                <TextBlock Classes="caption" Text="{loc:T ui.citizens}" />
                                                <TextBlock Classes="value" Text="{Binding Citizens}" />
                                                <TextBlock Classes="caption" Text="{Binding AgeSummary}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                        <Border Classes="card" Margin="3,0">
                                            <StackPanel>
                                                <TextBlock Classes="caption" Text="{loc:T ui.unemployed}" />
                                                <TextBlock Classes="value" Text="{Binding Unemployed}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Classes="card" Margin="3,0">
                                            <StackPanel>
                                                <TextBlock Classes="caption" Text="{loc:T ui.homelessFamilies}" />
                                                <TextBlock Classes="value" Text="{Binding HomelessFamilies}" />
                                                <TextBlock Classes="caption" Text="{Binding HomelessCitizens}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                        <Border Classes="card" Margin="6,0,0,0">
                                            <StackPanel>
                                                <TextBlock Classes="caption" Text="{loc:T ui.happiness}" />
                                                <TextBlock Classes="value" Text="{Binding Happiness}" />
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>

                                    <TextBlock Classes="section" Text="{loc:T ui.suggestions}" IsVisible="{Binding HasFindings}" />
                                    <ItemsControl ItemsSource="{Binding Findings}" />

                                    <TextBlock Classes="section" Text="{loc:T ui.population}" />
                                    <c:LineChart FlowDirection="LeftToRight" Height="180" Series="{Binding PopulationSeries}" LeftLabel="{Binding Left}" RightLabel="{Binding Right}" />

                                    <TextBlock Classes="section" Text="{loc:T ui.jobsAndHousing}" />
                                    <c:LineChart FlowDirection="LeftToRight" Height="180" Series="{Binding JobsHousingSeries}" LeftLabel="{Binding Left}" RightLabel="{Binding Right}" />

                                    <TextBlock Classes="section" Text="{loc:T ui.overallHappiness}" />
                                    <c:LineChart FlowDirection="LeftToRight" Height="180" Series="{Binding HappinessSeries}" LeftLabel="{Binding Left}" RightLabel="{Binding Right}" />

                                    <TextBlock Classes="section" Text="{loc:T ui.happinessByCategory0100Weakest}" />
                                    <ItemsControl ItemsSource="{Binding HappinessCategories}" />

                                    <UniformGrid Columns="2">
                                        <StackPanel Margin="0,0,12,0">
                                            <TextBlock Classes="section" Text="{loc:T ui.education}" />
                                            <ItemsControl ItemsSource="{Binding Education}" />
                                            <TextBlock Classes="section" Text="{loc:T ui.ageGroups}" />
                                            <ItemsControl ItemsSource="{Binding AgeGroups}" />
                                        </StackPanel>
                                        <StackPanel Margin="12,0,0,0">
                                            <TextBlock Classes="section" Text="{loc:T ui.wealthClassesLowestFirstAssumed}" />
                                            <ItemsControl ItemsSource="{Binding Wealth}" />
                                            <TextBlock Classes="section" Text="{loc:T ui.housingByTierCheapestFirstAssumed}" />
                                            <ItemsControl ItemsSource="{Binding Homes}" />
                                        </StackPanel>
                                    </UniformGrid>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- ============ Politics ============ -->
                        <TabItem Header="{loc:T ui.politics}">
                            <ScrollViewer>
                                <StackPanel Spacing="12" Margin="0,8,12,8" DataContext="{Binding PoliticsTab}" x:DataType="vm:PoliticsViewModel">

                                    <UniformGrid Columns="5">
                                        <Border Classes="card" Margin="0,0,6,0">
                                            <StackPanel>
                                                <TextBlock Classes="caption" Text="{loc:T ui.era}" />
                                                <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding Era}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                        <Border Classes="card" Margin="3,0">
                                            <StackPanel>
                                                <TextBlock Classes="caption" Text="{loc:T ui.constitutionSigned}" />
                                                <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding Constitution}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Classes="card" Margin="3,0">
                                            <StackPanel>
                                                <TextBlock Classes="caption" Text="{loc:T ui.nextElections}" />
                                                <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding Elections}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Classes="card" Margin="3,0">
                                            <StackPanel>
                                                <TextBlock Classes="caption" Text="{loc:T ui.researchPoints}" />
                                                <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding Research}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Classes="card" Margin="6,0,0,0">
                                            <StackPanel>
                                                <TextBlock Classes="caption" Text="{loc:T ui.victoryPoints}" />
                                                <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding VictoryPoints}" />
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>

                                    <TextBlock Classes="section" Text="{loc:T ui.suggestions}" IsVisible="{Binding HasFindings}" />
                                    <ItemsControl ItemsSource="{Binding Findings}" />

                                    <TextBlock Classes="section" Text="{loc:T ui.factions}" />
                                    <TextBlock Classes="caption" TextWrapping="Wrap"
                                               Text="{loc:T ui.standingIsTheSumOfThe}" />
                                    <Grid ColumnDefinitions="150,80,150,*">
                                        <TextBlock Classes="head" Text="{loc:T ui.faction}" />
                                        <TextBlock Grid.Column="1" Classes="head num" Text="{loc:T ui.standing}" />
                                        <TextBlock Grid.Column="2" Classes="head num" Text="{loc:T ui.history}" />
                                        <TextBlock Grid.Column="3" Classes="head" Margin="16,0,0,0" Text="{loc:T ui.mainCauses}" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding Factions}" />

                                    <UniformGrid Columns="2">
                                        <StackPanel Margin="0,0,12,0">
                                            <TextBlock Classes="section" Text="{loc:T ui.activeEdicts}" />
                                            <ItemsControl ItemsSource="{Binding Edicts}" />
                                            <TextBlock Classes="section" Text="{loc:T ui.landmarksBuilt}" />
                                            <TextBlock Text="{Binding Landmarks}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Margin="12,0,0,0">
                                            <TextBlock Classes="section" Text="{loc:T ui.constitution}" />
                                            <TextBlock Classes="caption" TextWrapping="Wrap" Text="{loc:T ui.onlyTopicsWithANonDefault}" />
                                            <ItemsControl ItemsSource="{Binding ConstitutionChoices}" />
                                            <TextBlock Classes="section" Text="{loc:T ui.demands}" />
                                            <ItemsControl ItemsSource="{Binding Demands}" />
                                        </StackPanel>
                                    </UniformGrid>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- ============ Economy ============ -->
                        <TabItem Header="{loc:T ui.economy}">
                            <ScrollViewer>
                                <StackPanel Spacing="12" Margin="0,8,12,8" DataContext="{Binding Economy}" x:DataType="vm:EconomyViewModel">

                                    <UniformGrid Columns="4">
                                        <Border Classes="card" Margin="0,0,6,0">
                                            <StackPanel>
                                                <TextBlock Classes="caption" Text="{loc:T ui.revenueLastYear}" />
                                                <TextBlock Classes="value" Text="{Binding YearlyRevenue}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Classes="card" Margin="3,0">
                                            <StackPanel>
                                                <TextBlock Classes="caption" Text="{loc:T ui.expensesLastYear}" />
                                                <TextBlock Classes="value" Text="{Binding YearlyExpenses}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Classes="card" Margin="3,0">
                                            <StackPanel>
                                                <TextBlock Classes="caption" Text="{loc:T ui.difference}" />
                                                <TextBlock Classes="value" Text="{Binding Balance}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Classes="card" Margin="6,0,0,0">
                                            <StackPanel>
                                                <TextBlock Classes="caption" Text="{loc:T ui.treasuryCovers}" />
                                                <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding Runway}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>

                                    <TextBlock Classes="section" Text="{loc:T ui.treasury}" />
                                    <c:LineChart FlowDirection="LeftToRight" Height="200" Series="{Binding TreasurySeries}"
                                                 LeftLabel="{Binding TreasuryLeft}" RightLabel="{Binding TreasuryRight}" />

                                    <TextBlock Classes="section" Text="{loc:T ui.monthlyRevenueAndExpenses}" />
                                    <c:LineChart FlowDirection="LeftToRight" Height="200" Series="{Binding FlowSeries}"
                                                 LeftLabel="{Binding FlowLeft}" RightLabel="{Binding FlowRight}" />

                                    <TextBlock Classes="section" Text="{loc:T ui.suggestions}" IsVisible="{Binding HasFindings}" />
                                    <ItemsControl ItemsSource="{Binding Findings}" />

                                    <UniformGrid Columns="2">
                                        <StackPanel Margin="0,0,12,0">
                                            <TextBlock Classes="section" Text="{loc:T ui.revenueByCategory}" />
                                            <ItemsControl ItemsSource="{Binding RevenueBreakdown}" />
                                        </StackPanel>
                                        <StackPanel Margin="12,0,0,0">
                                            <TextBlock Classes="section" Text="{loc:T ui.expensesByCategory}" />
                                            <ItemsControl ItemsSource="{Binding ExpenseBreakdown}" />
                                        </StackPanel>
                                    </UniformGrid>

                                    <TextBlock Classes="section" Text="{loc:T ui.costliestBuildingClassesLastYear}" />
                                    <TextBlock Classes="caption" TextWrapping="Wrap"
                                               Text="{loc:T ui.incomeIsOnlyTheDirectIncome}" />
                                    <Grid ColumnDefinitions="*,70,90,90,90,100">
                                        <TextBlock Classes="head" Text="{loc:T ui.class}" />
                                        <TextBlock Grid.Column="1" Classes="head num" Text="{loc:T ui.buildings}" />
                                        <TextBlock Grid.Column="2" Classes="head num" Text="{loc:T ui.wages}" />
                                        <TextBlock Grid.Column="3" Classes="head num" Text="{loc:T ui.upkeep}" />
                                        <TextBlock Grid.Column="4" Classes="head num" Text="{loc:T ui.income}" />
                                        <TextBlock Grid.Column="5" Classes="head num" Text="{loc:T ui.costBuilding}" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding CostCenters}" />
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- ============ Trade ============ -->
                        <TabItem Header="{loc:T ui.trade}">
                            <ScrollViewer>
                                <StackPanel Spacing="12" Margin="0,8,12,8" DataContext="{Binding Trade}" x:DataType="vm:TradeViewModel">

                                    <TextBlock Classes="section" Text="{loc:T ui.suggestions}" IsVisible="{Binding HasFindings}" />
                                    <ItemsControl ItemsSource="{Binding Findings}" />

                                    <TextBlock Classes="section" Text="{loc:T ui.resources}" />
                                    <TextBlock Classes="caption" TextWrapping="Wrap"
                                               Text="{loc:T ui.stockIsTheTotalOverEvery}" />
                                    <Grid ColumnDefinitions="*,70,70,90,90,80,80,70">
                                        <TextBlock Classes="head" Text="{loc:T ui.resource}" />
                                        <TextBlock Grid.Column="1" Classes="head num" Text="{loc:T ui.price}" />
                                        <TextBlock Grid.Column="2" Classes="head num" Text="{loc:T ui.change}" />
                                        <TextBlock Grid.Column="3" Classes="head num" Text="{loc:T ui.stock}" />
                                        <TextBlock Grid.Column="4" Classes="head num" Text="{loc:T ui.value}" />
                                        <TextBlock Grid.Column="5" Classes="head num" Text="{loc:T ui.exported}" />
                                        <TextBlock Grid.Column="6" Classes="head num" Text="{loc:T ui.imported}" />
                                        <TextBlock Grid.Column="7" Classes="head num" Text="{loc:T ui.routes}" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding Goods}" />
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- ============ Evolution ============ -->
                        <TabItem Header="{loc:T ui.evolution}">
                            <ScrollViewer>
                                <StackPanel Spacing="12" Margin="0,8,12,8" DataContext="{Binding EvolutionTab}" x:DataType="vm:EvolutionViewModel">

                                    <Border Classes="card" IsVisible="{Binding !HasComparison}">
                                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                                    </Border>

                                    <StackPanel Spacing="12" IsVisible="{Binding HasComparison}">
                                        <TextBlock Classes="caption" Text="{Binding ComparedWith}" TextWrapping="Wrap" />

                                        <Grid ColumnDefinitions="*,110,110,110">
                                            <TextBlock Classes="head" Text="{loc:T ui.metric}" />
                                            <TextBlock Grid.Column="1" Classes="head num" Text="{loc:T ui.before}" />
                                            <TextBlock Grid.Column="2" Classes="head num" Text="{loc:T ui.now}" />
                                            <TextBlock Grid.Column="3" Classes="head num" Text="{loc:T ui.change}" />
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding Metrics}" />

                                        <StackPanel IsVisible="{Binding HasBuildingChanges}">
                                            <TextBlock Classes="section" Text="{loc:T ui.buildingChanges}" />
                                            <ItemsControl ItemsSource="{Binding BuildingChanges}" />
                                        </StackPanel>

                                        <StackPanel IsVisible="{Binding HasFactionChanges}">
                                            <TextBlock Classes="section" Text="{loc:T ui.factionChanges}" />
                                            <ItemsControl ItemsSource="{Binding FactionChanges}" />
                                        </StackPanel>

                                        <StackPanel IsVisible="{Binding HasNewFindings}">
                                            <TextBlock Classes="section" Text="{loc:T ui.newSuggestions}" />
                                            <ItemsControl ItemsSource="{Binding NewFindings}" />
                                        </StackPanel>

                                        <StackPanel IsVisible="{Binding HasResolvedFindings}">
                                            <TextBlock Classes="section" Text="{loc:T ui.resolvedSuggestions}" />
                                            <ItemsControl ItemsSource="{Binding ResolvedFindings}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel IsVisible="{Binding HasSnapshots}">
                                        <TextBlock Classes="section" Text="{loc:T ui.analysedSaves}" />
                                        <Grid ColumnDefinitions="*,120,120">
                                            <TextBlock Classes="head" Text="{loc:T ui.save}" />
                                            <TextBlock Grid.Column="1" Classes="head num" Text="{loc:T ui.gameDate}" />
                                            <TextBlock Grid.Column="2" Classes="head num" Text="{loc:T ui.analysedOn}" />
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding Snapshots}" />
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                    </TabControl>
                </DataTemplate>
            </ContentControl.ContentTemplate>
        </ContentControl>
    </DockPanel>
</Window>
