<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Tropico.Desktop.ViewModels"
        xmlns:services="using:Tropico.Desktop.Services"
        xmlns:c="using:Tropico.Desktop.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="720"
        x:Class="Tropico.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Width="1000" Height="760"
        Title="Tropico Advisor">

    <Design.DataContext>
        <!-- Design-time only: the runtime DataContext is set in App.axaml.cs -->
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="Border.card">
            <Setter Property="Padding" Value="12" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
        </Style>
        <Style Selector="Border.finding">
            <Setter Property="BorderThickness" Value="4,0,0,0" />
            <Setter Property="BorderBrush" Value="Gray" />
        </Style>
        <Style Selector="Border.finding.warning">
            <Setter Property="BorderBrush" Value="Orange" />
        </Style>
        <Style Selector="Border.finding.critical">
            <Setter Property="BorderBrush" Value="Crimson" />
        </Style>
        <Style Selector="Border.finding.uncertain TextBlock.message">
            <Setter Property="Opacity" Value="0.75" />
        </Style>
        <Style Selector="TextBlock.caption">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.65" />
        </Style>
        <Style Selector="TextBlock.value">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.section">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
        <Style Selector="TextBlock.num">
            <Setter Property="TextAlignment" Value="Right" />
        </Style>
        <Style Selector="TextBlock.head">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Opacity" Value="0.65" />
        </Style>
    </Window.Styles>

    <Window.DataTemplates>

        <DataTemplate DataType="vm:FindingViewModel">
            <Border Classes="card finding" Margin="0,0,0,8"
                    Classes.warning="{Binding IsWarning}"
                    Classes.critical="{Binding IsCritical}"
                    Classes.uncertain="{Binding IsUncertain}">
                <StackPanel Spacing="4">
                    <TextBlock Classes="message" Text="{Binding Message}" TextWrapping="Wrap" FontWeight="SemiBold" />
                    <ItemsControl ItemsSource="{Binding Evidence}" IsVisible="{Binding HasEvidence}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Classes="caption" Text="{Binding StringFormat='• {0}'}" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding Suggestion, StringFormat='→ {0}'}" IsVisible="{Binding HasSuggestion}" TextWrapping="Wrap" />
                    <TextBlock Classes="caption" Text="{Binding Label}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="vm:BarRow">
            <Grid ColumnDefinitions="220,*,120" Margin="0,2">
                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                <ProgressBar Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding Fraction}" Height="10" Margin="8,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Classes="num" Text="{Binding Value}" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="vm:BreakdownRow">
            <Grid ColumnDefinitions="*,110,60" Margin="0,2">
                <TextBlock Text="{Binding Name}" />
                <TextBlock Grid.Column="1" Classes="num" Text="{Binding Amount}" />
                <TextBlock Grid.Column="2" Classes="num caption" Text="{Binding Share}" />
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="vm:CostCenterRow">
            <Grid ColumnDefinitions="*,70,90,90,90,100" Margin="0,2">
                <TextBlock Text="{Binding Name}" />
                <TextBlock Grid.Column="1" Classes="num" Text="{Binding Buildings}" />
                <TextBlock Grid.Column="2" Classes="num" Text="{Binding Wages}" />
                <TextBlock Grid.Column="3" Classes="num" Text="{Binding Upkeep}" />
                <TextBlock Grid.Column="4" Classes="num" Text="{Binding Income}" />
                <TextBlock Grid.Column="5" Classes="num" Text="{Binding PerBuilding}" />
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="vm:GoodRow">
            <Grid ColumnDefinitions="*,70,70,90,90,80,80,70" Margin="0,2">
                <TextBlock Text="{Binding Resource}" />
                <TextBlock Grid.Column="1" Classes="num" Text="{Binding Price}" />
                <TextBlock Grid.Column="2" Classes="num" Text="{Binding PriceChange}" />
                <TextBlock Grid.Column="3" Classes="num" Text="{Binding Stock}" />
                <TextBlock Grid.Column="4" Classes="num" Text="{Binding StockValue}" />
                <TextBlock Grid.Column="5" Classes="num" Text="{Binding Exported}" />
                <TextBlock Grid.Column="6" Classes="num" Text="{Binding Imported}" />
                <TextBlock Grid.Column="7" Classes="num" Text="{Binding Routes}" />
            </Grid>
        </DataTemplate>

    </Window.DataTemplates>

    <DockPanel Margin="16">

        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Content="Refresh" Margin="8,0,0,0"
                    Command="{Binding RefreshCommand}" />
            <ComboBox ItemsSource="{Binding Saves}"
                      SelectedItem="{Binding SelectedSave}"
                      HorizontalAlignment="Stretch"
                      PlaceholderText="Select a Tropico 6 save">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="services:SaveFileItem">
                        <TextBlock Text="{Binding DisplayName}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </DockPanel>

        <TextBlock DockPanel.Dock="Top" Text="Analysing save..." IsVisible="{Binding IsBusy}" Margin="0,0,0,8" />
        <TextBlock DockPanel.Dock="Top" Text="{Binding ErrorMessage}" Foreground="Crimson"
                   IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   TextWrapping="Wrap" Margin="0,0,0,8" />
        <TextBlock DockPanel.Dock="Top" Text="{Binding StatusMessage}"
                   IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   Margin="0,0,0,8" />

        <ContentControl Content="{Binding Report}"
                        IsVisible="{Binding Report, Converter={x:Static ObjectConverters.IsNotNull}}">
            <ContentControl.ContentTemplate>
                <DataTemplate x:DataType="vm:IslandReportViewModel">
                    <TabControl>

                        <!-- ============ Overview ============ -->
                        <TabItem Header="Overview">
                            <ScrollViewer>
                                <StackPanel Spacing="12" Margin="0,8,12,8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" />
                                        <TextBlock Classes="caption" Text="{Binding GameBuild}" />
                                    </StackPanel>

                                    <UniformGrid Columns="3">
                                        <Border Classes="card" Margin="0,0,8,0">
                                            <StackPanel>
                                                <TextBlock Classes="caption" Text="Buildings" />
                                                <TextBlock Classes="value" Text="{Binding Buildings}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Classes="card" Margin="4,0">
                                            <StackPanel>
                                                <TextBlock Classes="caption" Text="Citizens" />
                                                <TextBlock Classes="value" Text="{Binding Citizens}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Classes="card" Margin="8,0,0,0">
                                            <StackPanel>
                                                <TextBlock Classes="caption" Text="Treasury" />
                                                <TextBlock Classes="value" Text="{Binding Treasury}" />
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>

                                    <TextBlock Classes="section" Text="Suggestions" />
                                    <TextBlock Classes="caption" Text="No findings." IsVisible="{Binding !HasFindings}" />
                                    <ItemsControl ItemsSource="{Binding Findings}" />

                                    <TextBlock Classes="section" Text="Most common buildings" />
                                    <ItemsControl ItemsSource="{Binding TopBuildings}" />
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- ============ Population ============ -->
                        <TabItem Header="Population">
                            <ScrollViewer>
                                <StackPanel Spacing="12" Margin="0,8,12,8" DataContext="{Binding Population}" x:DataType="vm:PopulationViewModel">

                                    <UniformGrid Columns="4">
                                        <Border Classes="card" Margin="0,0,6,0">
                                            <StackPanel>
                                                <TextBlock Classes="caption" Text="Citizens" />
                                                <TextBlock Classes="value" Text="{Binding Citizens}" />
                                                <TextBlock Classes="caption" Text="{Binding AgeSummary}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                        <Border Classes="card" Margin="3,0">
                                            <StackPanel>
                                                <TextBlock Classes="caption" Text="Unemployed" />
                                                <TextBlock Classes="value" Text="{Binding Unemployed}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Classes="card" Margin="3,0">
                                            <StackPanel>
                                                <TextBlock Classes="caption" Text="Homeless families" />
                                                <TextBlock Classes="value" Text="{Binding HomelessFamilies}" />
                                                <TextBlock Classes="caption" Text="{Binding HomelessCitizens}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                        <Border Classes="card" Margin="6,0,0,0">
                                            <StackPanel>
                                                <TextBlock Classes="caption" Text="Happiness" />
                                                <TextBlock Classes="value" Text="{Binding Happiness}" />
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>

                                    <TextBlock Classes="section" Text="Suggestions" IsVisible="{Binding HasFindings}" />
                                    <ItemsControl ItemsSource="{Binding Findings}" />

                                    <TextBlock Classes="section" Text="Population" />
                                    <c:LineChart Height="180" Series="{Binding PopulationSeries}" LeftLabel="{Binding Left}" RightLabel="{Binding Right}" />

                                    <TextBlock Classes="section" Text="Jobs and housing" />
                                    <c:LineChart Height="180" Series="{Binding JobsHousingSeries}" LeftLabel="{Binding Left}" RightLabel="{Binding Right}" />

                                    <TextBlock Classes="section" Text="Overall happiness" />
                                    <c:LineChart Height="180" Series="{Binding HappinessSeries}" LeftLabel="{Binding Left}" RightLabel="{Binding Right}" />

                                    <TextBlock Classes="section" Text="Happiness by category (0-100, weakest first)" />
                                    <ItemsControl ItemsSource="{Binding HappinessCategories}" />

                                    <UniformGrid Columns="2">
                                        <StackPanel Margin="0,0,12,0">
                                            <TextBlock Classes="section" Text="Education" />
                                            <ItemsControl ItemsSource="{Binding Education}" />
                                            <TextBlock Classes="section" Text="Age groups" />
                                            <ItemsControl ItemsSource="{Binding AgeGroups}" />
                                        </StackPanel>
                                        <StackPanel Margin="12,0,0,0">
                                            <TextBlock Classes="section" Text="Wealth classes (lowest first, assumed)" />
                                            <ItemsControl ItemsSource="{Binding Wealth}" />
                                            <TextBlock Classes="section" Text="Housing by tier (cheapest first, assumed)" />
                                            <ItemsControl ItemsSource="{Binding Homes}" />
                                        </StackPanel>
                                    </UniformGrid>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- ============ Economy ============ -->
                        <TabItem Header="Economy">
                            <ScrollViewer>
                                <StackPanel Spacing="12" Margin="0,8,12,8" DataContext="{Binding Economy}" x:DataType="vm:EconomyViewModel">

                                    <UniformGrid Columns="4">
                                        <Border Classes="card" Margin="0,0,6,0">
                                            <StackPanel>
                                                <TextBlock Classes="caption" Text="Revenue (last year)" />
                                                <TextBlock Classes="value" Text="{Binding YearlyRevenue}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Classes="card" Margin="3,0">
                                            <StackPanel>
                                                <TextBlock Classes="caption" Text="Expenses (last year)" />
                                                <TextBlock Classes="value" Text="{Binding YearlyExpenses}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Classes="card" Margin="3,0">
                                            <StackPanel>
                                                <TextBlock Classes="caption" Text="Difference" />
                                                <TextBlock Classes="value" Text="{Binding Balance}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Classes="card" Margin="6,0,0,0">
                                            <StackPanel>
                                                <TextBlock Classes="caption" Text="Treasury covers" />
                                                <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding Runway}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>

                                    <TextBlock Classes="section" Text="Treasury" />
                                    <c:LineChart Height="200" Series="{Binding TreasurySeries}"
                                                 LeftLabel="{Binding TreasuryLeft}" RightLabel="{Binding TreasuryRight}" />

                                    <TextBlock Classes="section" Text="Monthly revenue and expenses" />
                                    <c:LineChart Height="200" Series="{Binding FlowSeries}"
                                                 LeftLabel="{Binding FlowLeft}" RightLabel="{Binding FlowRight}" />

                                    <TextBlock Classes="section" Text="Suggestions" IsVisible="{Binding HasFindings}" />
                                    <ItemsControl ItemsSource="{Binding Findings}" />

                                    <UniformGrid Columns="2">
                                        <StackPanel Margin="0,0,12,0">
                                            <TextBlock Classes="section" Text="Revenue by category" />
                                            <ItemsControl ItemsSource="{Binding RevenueBreakdown}" />
                                        </StackPanel>
                                        <StackPanel Margin="12,0,0,0">
                                            <TextBlock Classes="section" Text="Expenses by category" />
                                            <ItemsControl ItemsSource="{Binding ExpenseBreakdown}" />
                                        </StackPanel>
                                    </UniformGrid>

                                    <TextBlock Classes="section" Text="Costliest building classes (last year)" />
                                    <TextBlock Classes="caption" TextWrapping="Wrap"
                                               Text="Income is only the direct income (visitor fees and rents). Producers earn through exports, so a low income is not a loss." />
                                    <Grid ColumnDefinitions="*,70,90,90,90,100">
                                        <TextBlock Classes="head" Text="Class" />
                                        <TextBlock Grid.Column="1" Classes="head num" Text="Buildings" />
                                        <TextBlock Grid.Column="2" Classes="head num" Text="Wages" />
                                        <TextBlock Grid.Column="3" Classes="head num" Text="Upkeep" />
                                        <TextBlock Grid.Column="4" Classes="head num" Text="Income" />
                                        <TextBlock Grid.Column="5" Classes="head num" Text="Cost / building" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding CostCenters}" />
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- ============ Trade ============ -->
                        <TabItem Header="Trade">
                            <ScrollViewer>
                                <StackPanel Spacing="12" Margin="0,8,12,8" DataContext="{Binding Trade}" x:DataType="vm:TradeViewModel">

                                    <TextBlock Classes="section" Text="Suggestions" IsVisible="{Binding HasFindings}" />
                                    <ItemsControl ItemsSource="{Binding Findings}" />

                                    <TextBlock Classes="section" Text="Resources" />
                                    <TextBlock Classes="caption" TextWrapping="Wrap"
                                               Text="Stock is the total over every stock of the resource. Price change compares the last price sample with the earlier average (sample order unverified). Routes: exports offered / imports offered." />
                                    <Grid ColumnDefinitions="*,70,70,90,90,80,80,70">
                                        <TextBlock Classes="head" Text="Resource" />
                                        <TextBlock Grid.Column="1" Classes="head num" Text="Price" />
                                        <TextBlock Grid.Column="2" Classes="head num" Text="Change" />
                                        <TextBlock Grid.Column="3" Classes="head num" Text="Stock" />
                                        <TextBlock Grid.Column="4" Classes="head num" Text="Value" />
                                        <TextBlock Grid.Column="5" Classes="head num" Text="Exported" />
                                        <TextBlock Grid.Column="6" Classes="head num" Text="Imported" />
                                        <TextBlock Grid.Column="7" Classes="head num" Text="Routes" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding Goods}" />
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                    </TabControl>
                </DataTemplate>
            </ContentControl.ContentTemplate>
        </ContentControl>
    </DockPanel>
</Window>
